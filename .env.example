# Postgres connection string (any Postgres works: Neon, Supabase, Vercel Postgres,
# Railway, or a local instance).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/herocity"

# PayPal REST credentials — create an app at https://developer.paypal.com/dashboard/applications
# Use sandbox credentials for development and set PAYPAL_ENV=live in production.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Same client ID as above, exposed to the browser to render the PayPal buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Auth.js (NextAuth) — generate a secret with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: set to "true" to enable a passwordless "Dev Login"
# provider so you can sign in without Google credentials. NEVER enable in
# production — it lets anyone sign in as any email address.
AUTH_DEV_LOGIN="false"
