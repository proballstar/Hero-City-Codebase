# Postgres connection string (any Postgres works: Neon, Supabase, Vercel Postgres,
# Railway, or a local instance).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/herocity"

# Stripe secret key from https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) in development and a live key (sk_live_...) in production.
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret (whsec_...) for the checkout.session.completed
# event — create the endpoint at https://dashboard.stripe.com/webhooks pointing
# to <your-origin>/api/stripe/webhook. Optional in local development: donations
# are also recorded when the donor returns from checkout.
STRIPE_WEBHOOK_SECRET=""

# Auth.js (NextAuth) — generate a secret with: npx auth secret
AUTH_SECRET=""

# Canonical URL the app is browsed at (must match your browser's address bar).
# Used for sign-in redirects and Stripe checkout return URLs. Optional when
# the app is served directly (e.g. Vercel); required behind proxies/tunnels
# such as Codespaces port forwarding.
AUTH_URL=""

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: set to "true" to enable a passwordless "Dev Login"
# provider so you can sign in without Google credentials. NEVER enable in
# production — it lets anyone sign in as any email address.
AUTH_DEV_LOGIN="false"
