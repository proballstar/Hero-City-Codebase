generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_CLAIM
  VERIFIED
}

enum UserRole {
  USER
  ADMIN
}

model Post {
  id            String       @id @default(cuid())
  name          String
  content       String
  /// Display name shown on the post; kept denormalized so posts survive
  /// author account deletion.
  authorName    String
  author        User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId      String?
  /// True when the author is telling their own story (author == hero).
  isOwnStory    Boolean      @default(false)
  /// The hero's email (lowercased). Whoever signs in with this email is the
  /// hero: they may edit the post and their activity is tracked in events.
  heroEmail     String?
  heroProfile   HeroProfile? @relation(fields: [heroProfileId], references: [id], onDelete: SetNull)
  heroProfileId String?
  flagged       Boolean      @default(false)
  image         Image?
  donations     Donation[]
  events        PostEvent[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([heroProfileId])
}

/// The canonical identity and payout destination for a hero. Existing Post
/// records are stories in the product UI, so the relation is named stories.
model HeroProfile {
  id                     String                 @id @default(cuid())
  heroName               String
  bio                    String?
  verificationStatus     VerificationStatus     @default(UNVERIFIED)
  stripeAccountId        String?                @unique
  contactEmail           String?
  claimedByUser          User?                  @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedByUserId        String?
  stories                Post[]
  claimTokens            HeroClaimToken[]
  verificationEvents     VerificationEvent[]
  evidence               VerificationEvidence[]
  stripeIdentityVerified Boolean                @default(false)
  payoutsFrozen          Boolean                @default(false)
  externalProofUrl       String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([verificationStatus])
  @@index([claimedByUserId])
}

model VerificationEvidence {
  id            String      @id @default(cuid())
  heroProfile   HeroProfile @relation(fields: [heroProfileId], references: [id], onDelete: Cascade)
  heroProfileId String
  label         String
  kind          String
  url           String
  createdAt     DateTime    @default(now())

  @@index([heroProfileId, createdAt])
}

model HeroClaimToken {
  id            String      @id @default(cuid())
  /// SHA-256 digest of the 256-bit secret sent by email.
  token         String      @unique
  heroProfile   HeroProfile @relation(fields: [heroProfileId], references: [id], onDelete: Cascade)
  heroProfileId String
  email         String
  expiresAt     DateTime
  used          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([heroProfileId, used])
  @@index([email])
}

model VerificationEvent {
  id            String      @id @default(cuid())
  heroProfile   HeroProfile @relation(fields: [heroProfileId], references: [id], onDelete: Cascade)
  heroProfileId String
  type          String
  actorUserId   String?
  details       String?
  createdAt     DateTime    @default(now())

  @@index([heroProfileId, createdAt])
}

/// Append-only activity log per post: creation, edits, hero invites and
/// hero engagement (views/edits by the person the story is about).
model PostEvent {
  id         String   @id @default(cuid())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  /// CREATED | EDITED | INVITE_SENT | HERO_VIEWED
  type       String
  actorName  String
  actorEmail String?
  /// True when the actor is the post's hero (signed in with heroEmail).
  isHero     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId, type])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  role          UserRole      @default(USER)
  claimedHeroes HeroProfile[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Cover images are stored directly in the database so the app is
/// self-contained — no external object storage account is required.
model Image {
  id       String @id @default(cuid())
  data     Bytes
  mimeType String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String @unique
}

model Donation {
  id          String   @id @default(cuid())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  provider    String   @default("stripe")
  /// Payment provider's reference (Stripe Checkout session id).
  providerRef String   @unique
  payerName   String?
  status      String
  createdAt   DateTime @default(now())
}
